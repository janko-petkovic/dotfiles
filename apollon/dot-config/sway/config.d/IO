# output eDP-1 resolution 1920x1200 position 0,0
output eDP-1  pos 3840 0   
output HDMI-A-1 pos 0 0 resolution 3840 2160


# More defaults are available in /usr/share/backgrounds/sway/
output * bg ~/pictures/dark-owl.jpg fill

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
}

input type:keyboard {
  xkb_layout "us"
}
