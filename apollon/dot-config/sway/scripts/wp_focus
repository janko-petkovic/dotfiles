#!/bin/bash

ws_num=$(swaymsg -t get_workspaces | jq '.[] | select(.focused) | .num')

case "$1" in
  next) target_ws_num=$((ws_num+1)) ;;
  prev)
    if [[ $ws_num == 1 ]]; then
      exit 1;
    else
      target_ws_num=$((ws_num-1))
    fi ;;
  *) exit 1 ;;
esac

echo $target_ws_num

swaymsg workspace number $target_ws_num
